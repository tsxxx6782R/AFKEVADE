-- ฟังก์ชันส่ง Discord แบบปลอดภัย (รองรับ executor เกือบทุกตัว)
local function SendDiscordWebhook(textMessage)
    if activeWebhookUrl == "" or not activeWebhookUrl:find("https://discord.com/api/webhooks/") then 
        warn("❌ ลิงก์ Webhook ไม่ถูกต้องหรือไม่พบลิงก์")
        return false 
    end
    
    local totalSec = math.floor(tick() - scriptStartTime)
    local hours = math.floor(totalSec / 3600)
    local mins = math.floor((totalSec % 3600) / 60)
    local secs = totalSec % 60
    
    local data = {
        ["content"] = "",
        ["embeds"] = {{
            ["title"] = "🤖 Evade Abdul Hub - แจ้งเตือนสถานะ",
            ["description"] = textMessage,
            ["color"] = 3066993,
            ["fields"] = {
                {["name"] = "⏳ เวลา AFK", ["value"] = string.format("%dชม. %dนาที %dวินาที", hours, mins, secs), ["inline"] = true},
                {["name"] = "🏆 รอบที่ฟาร์มได้", ["value"] = tostring(totalWins) .. " รอบ", ["inline"] = true}
            },
            ["footer"] = {["text"] = "ระบบเชื่อมต่อ Discord สำเร็จ 100%"},
            ["timestamp"] = DateTime.now():ToIsoDate()
        }}
    }
    
    local success, response = pcall(function()
        local encodedData = HttpService:JSONEncode(data)
        if syn and syn.request then
            syn.request({
                Url = activeWebhookUrl,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = encodedData
            })
        elseif http_request then
            http_request({
                Url = activeWebhookUrl,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = encodedData
            })
        else
            HttpService:PostAsync(activeWebhookUrl, encodedData, Enum.HttpContentType.ApplicationJson)
        end
    end)
    
    return success
end

