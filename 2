local function CreateToggle(name, yPos, callback)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0, 240, 0, 35)
    Label.Position = UDim2.new(0, 15, 0, yPos)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(220, 220, 240)
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ContentArea

    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0, 48, 0, 24)
    ToggleBtn.Position = UDim2.new(1, -63, 0, yPos + 5)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    ToggleBtn.Text = ""
    ToggleBtn.Parent = ContentArea
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)

    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.new(0, 18, 0, 18)
    Circle.Position = UDim2.new(0, 3, 0.5, -9)
    Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Circle.Parent = ToggleBtn
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

    local state = false
    ToggleBtn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            Circle:TweenPosition(UDim2.new(1, -21, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        else
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
            Circle:TweenPosition(UDim2.new(0, 3, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        end
        callback(state)
    end)
end

local platformPart = nil
local farmConn = nil
local autoReportConn = nil

CreateToggle("ออโต้ฟาร์มลอยฟ้า + แจ้งเตือนออโต้", 105, function(state)
    if state then
        farmConn = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if not platformPart or not platformPart.Parent then
                    platformPart = Instance.new("Part")
                    platformPart.Size = Vector3.new(10, 1, 10)
                    platformPart.Position = Vector3.new(hrp.Position.X, 350, hrp.Position.Z)
                    platformPart.Anchored = true
                    platformPart.Transparency = 0.5
                    platformPart.Parent = Workspace
                end
                hrp.CFrame = CFrame.new(platformPart.Position + Vector3.new(0, 3, 0))
            else
                if platformPart then
                    platformPart:Destroy()
                    platformPart = nil
                    _G.EvadeAbdulTotalWins = _G.EvadeAbdulTotalWins + 1
                end
            end
        end)

        autoReportConn = task.spawn(function()
            while task.wait(180) do
                if activeWebhookUrl ~= "" then
                    SendDiscordWebhook("📊 รายงานสถานะอัตโนมัติ (ทุกๆ 3 นาที): ฟาร์มปกติ ปลอดภัยดี")
                end
            end
        end)
    else
        if farmConn then farmConn:Disconnect() farmConn = nil end
        if autoReportConn then task.cancel(autoReportConn) autoReportConn = nil end
        if platformPart then platformPart:Destroy() platformPart = nil end
    end
end)

