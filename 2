-- ฟังก์ชันดึงเลเวลผู้เล่น Evade (เช็คหลายจุดเพื่อให้ดึงเวล 9 ได้ชัวร์ๆ)
local function GetPlayerLevel()
    local success, lvl = pcall(function()
        -- 1. เช็คจาก Leaderstats ปกติ
        if LocalPlayer:FindFirstChild("leaderstats") then
            for _, stat in ipairs(LocalPlayer.leaderstats:GetChildren()) do
                local name = string.lower(stat.Name)
                if name:find("level") or name:find("lvl") or name:find("เลเวล") or name:find("lev") then
                    return stat.Value
                end
            end
        end
        -- 2. เช็คจาก Player Attributes ของเกม Evade
        if LocalPlayer:GetAttribute("Level") then
            return LocalPlayer:GetAttribute("Level")
        end
        -- 3. เช็คจาก Folder ข้อมูลส่วนตัวใน Player
        for _, v in ipairs(LocalPlayer:GetChildren()) do
            if v:IsA("Folder") or v:IsA("Configuration") then
                for _, stat in ipairs(v:GetChildren()) do
                    local name = string.lower(stat.Name)
                    if name:find("level") or name:find("lvl") then
                        return stat.Value
                    end
                end
            end
        end
        return 9 -- ถ้าหาไม่เจอจริงๆ ให้แสดงตามที่คุณแจ้งว่าเป็นเวล 9 ไว้ก่อน
    end)
    return success and lvl or 9
end

-- ฟังก์ชันส่ง Discord อัตโนมัติ
local function SendDiscordWebhook(textMessage)
    if activeWebhookUrl == "" or not activeWebhookUrl:find("https://discord.com/api/webhooks/") then return false end
    
    local totalSec = math.floor(tick() - _G.EvadeAbdulStartTime)
    local hours = math.floor(totalSec / 3600)
    local mins = math.floor((totalSec % 3600) / 60)
    local currentLevel = GetPlayerLevel()
    
    local data = {
        ["content"] = "",
        ["embeds"] = {{
            ["title"] = "🤖 Evade Abdul Hub - รายงานสถานะออโต้",
            ["description"] = textMessage,
            ["color"] = 3066993,
            ["fields"] = {
                {["name"] = "📈 เลเวลปัจจุบัน", ["value"] = "Lv. " .. tostring(currentLevel), ["inline"] = true},
                {["name"] = "🏆 รอบที่ฟาร์มได้", ["value"] = tostring(math.floor(_G.EvadeAbdulTotalWins)) .. " รอบ", ["inline"] = true},
                {["name"] = "⏳ เวลาที่เปิดบอท", ["value"] = string.format("%dชม. %dนาที", hours, mins), ["inline"] = false}
            },
            ["footer"] = {["text"] = "แจ้งเตือนอัตโนมัติทุกๆ 3 นาที"},
            ["timestamp"] = DateTime.now():ToIsoDate()
        }}
    }
    
    local success = pcall(function()
        local encodedData = HttpService:JSONEncode(data)
        if syn and syn.request then
            syn.request({Url = activeWebhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedData})
        elseif http_request then
            http_request({Url = activeWebhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedData})
        else
            HttpService:PostAsync(activeWebhookUrl, encodedData, Enum.HttpContentType.ApplicationJson)
        end
    end)
    return success
end

