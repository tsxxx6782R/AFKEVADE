-- ตัวแปรควบคุม
local autoJumpEnabled = false
local antiAfkEnabled = true
local lagSwitchActive = false
local isMinimized = false

local function toggleAutoJump()
    autoJumpEnabled = not autoJumpEnabled
    autoJumpBtn.Text = autoJumpEnabled and "Auto Jump: ON [K]" or "Auto Jump: OFF [K]"
    autoJumpBtn.BackgroundColor3 = autoJumpEnabled and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(200, 0, 0)
end

-- ฟังก์ชันกดทำงาน 0.5 วินาทีแล้วตัดกลับมาปิดอัตโนมัติ
local function triggerLagSwitch05()
    if lagSwitchActive then return end
    lagSwitchActive = true
    
    lagSwitchBtn.Text = "Lagging... [0.5s]"
    lagSwitchBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0) -- สีเขียวชั่วขณะ
    
    local startTime = tick()
    local connection
    connection = RunService.RenderStepped:Connect(function()
        local char = localPlayer.Character
        if char then
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            if rootPart then
                rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
            end
        end
        
        -- ครบ 0.5 วินาทีแล้วหยุดอัตโนมัติทันที
        if tick() - startTime >= 0.5 then
            connection:Disconnect()
            lagSwitchActive = false
            lagSwitchBtn.Text = "Lag Switch [0.5s] [E]"
            lagSwitchBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- กลับเป็นสีแดง
        end
    end)
end

-- ย่อ/ขยายหน้าต่างจิ๋ว
minimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        mainFrame.Size = UDim2.new(0, 180, 0, 35)
        autoJumpBtn.Visible = false
        antiAfkBtn.Visible = false
        lagSwitchBtn.Visible = false
        korbloxBtn.Visible = false
        minimizeBtn.Text = "+"
    else
        mainFrame.Size = UDim2.new(0, 180, 0, 210)
        autoJumpBtn.Visible = true
        antiAfkBtn.Visible = true
        lagSwitchBtn.Visible = true
        korbloxBtn.Visible = true
        minimizeBtn.Text = "-"
    end
end)

autoJumpBtn.MouseButton1Click:Connect(toggleAutoJump)
antiAfkBtn.MouseButton1Click:Connect(function()
    antiAfkEnabled = not antiAfkEnabled
    antiAfkBtn.Text = antiAfkEnabled and "Anti-AFK: ON" or "Anti-AFK: OFF"
    antiAfkBtn.BackgroundColor3 = antiAfkEnabled and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(200, 0, 0)
end)
lagSwitchBtn.MouseButton1Click:Connect(triggerLagSwitch05)

-- คีย์ลัด (K และ E)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == Enum.KeyCode.K then
            toggleAutoJump()
        elseif input.KeyCode == Enum.KeyCode.E then
            triggerLagSwitch05()
        end
    end
end)

-- ฟังก์ชันขากุดซ้าย Korblox
korbloxBtn.MouseButton1Click:Connect(function()
    local char = localPlayer.Character
    if char then
        for _, partName in ipairs({"LeftLowerLeg", "LeftFoot", "LeftLeg"}) do
            local part = char:FindFirstChild(partName)
            if part then
                part.Transparency = 1
                part.CanCollide = false
                for _, child in ipairs(part:GetChildren()) do
                    if child:IsA("SpecialMesh") or child:IsA("BlockMesh") or child:IsA("CylinderMesh") then
                        child.Scale = Vector3.new(0, 0, 0)
                    end
                end
            end
        end
        korbloxBtn.Text = "Korblox Applied!"
        korbloxBtn.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
    end
end)

-- ลูป Auto Jump ปกติ
RunService.RenderStepped:Connect(function()
    if autoJumpEnabled then
        local char = localPlayer.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if humanoid:GetState() == Enum.HumanoidStateType.Running and humanoid.MoveDirection.Magnitude > 0 then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end
    end
end)

-- Anti-AFK
localPlayer.Idled:Connect(function()
    if antiAfkEnabled then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)

