-- อัปเดต FPS และเวลา AFK แบบเรียลไทม์
local frameCount = 0
local lastUpdate = tick()
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    
    if now - lastUpdate >= 1 then
        local fps = math.floor(frameCount / (now - lastUpdate))
        FpsTextLabel.Text = "FPS: " .. tostring(fps)
        frameCount = 0
        lastUpdate = now
    end
    
    local totalSeconds = math.floor(now - scriptStartTime)
    local minutes = math.floor(totalSeconds / 60)
    local seconds = totalSeconds % 60
    AfkTimeLabel.Text = string.format("AFK: %dน %dว", minutes, seconds)
end)

-- 6. ระบบสะเก็ดหิมะสายรุ้งสามมิติ (3D Rainbow Snowflakes Effect)
local SnowContainer = Instance.new("Folder")
SnowContainer.Name = "SnowContainer"
SnowContainer.Parent = MainFrame

local snowflakes = {}
math.randomseed(tick())

for i = 1, 18 do
    local flake = Instance.new("Frame")
    flake.Size = UDim2.new(0, math.random(4, 7), 0, math.random(4, 7))
    flake.Position = UDim2.new(math.random(), 0, -0.1, 0)
    flake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    flake.BorderSizePixel = 0
    
    local flakeCorner = Instance.new("UICorner")
    flakeCorner.CornerRadius = UDim.new(1, 0)
    flakeCorner.Parent = flake
    
    flake.Parent = SnowContainer
    
    table.insert(snowflakes, {
        Object = flake,
        Speed = math.random(20, 50) / 1000,
        XOffset = math.random(-50, 50) / 500,
        Depth = math.random(1, 3)
    })
end

RunService.RenderStepped:Connect(function()
    for _, flakeData in ipairs(snowflakes) do
        local flake = flakeData.Object
        local pos = flake.Position
        local newY = pos.Y.Scale + (flakeData.Speed * (1 / flakeData.Depth))
        
        if newY > 1.1 then
            newY = -0.1
            flake.Position = UDim2.new(math.random(), 0, newY, 0)
        else
            flake.Position = UDim2.new(pos.X.Scale + (flakeData.XOffset * 0.01), 0, newY, 0)
        end
        
        local hue = (tick() + flakeData.Depth * 0.5) % 5 / 5
        flake.BackgroundColor3 = Color3.fromHSV(hue, 0.8, 1)
        flake.BackgroundTransparency = 0.2 * flakeData.Depth
    end
end)

