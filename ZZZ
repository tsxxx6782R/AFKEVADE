local function CreateToggleRow(name, yPos, callback)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0, 230, 0, 35)
    Label.Position = UDim2.new(0, 20, 0, yPos)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(220, 220, 240)
    Label.TextSize = 12
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ContentArea

    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0, 48, 0, 24)
    ToggleBtn.Position = UDim2.new(1, -70, 0, yPos + 5)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    ToggleBtn.AutoButtonColor = false
    ToggleBtn.Text = ""
    ToggleBtn.Parent = ContentArea
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)

    local ToggleCircle = Instance.new("Frame")
    ToggleCircle.Size = UDim2.new(0, 18, 0, 18)
    ToggleCircle.Position = UDim2.new(0, 3, 0.5, -9)
    ToggleCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ToggleCircle.Parent = ToggleBtn
    Instance.new("UICorner", ToggleCircle).CornerRadius = UDim.new(1, 0)

    local isEnabled = false
    ToggleBtn.MouseButton1Click:Connect(function()
        isEnabled = not isEnabled
        if isEnabled then
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            ToggleCircle:TweenPosition(UDim2.new(1, -21, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        else
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
            ToggleCircle:TweenPosition(UDim2.new(0, 3, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        end
        callback(isEnabled)
    end)
end

-- 1. ออโต้ฟาร์มลอยฟ้า + นับรอบส่ง Webhook
local platformPart = nil
local farmConnection = nil
CreateToggleRow("ออโต้ฟาร์มลอยฟ้า (Auto Farm High)", 75, function(state)
    if state then
        farmConnection = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hum and hum.Health > 0 then
                if not platformPart or not platformPart.Parent then
                    platformPart = Instance.new("Part")
                    platformPart.Name = "AbdulFarmPlatform"
                    platformPart.Size = Vector3.new(10, 1, 10)
                    platformPart.Position = Vector3.new(hrp.Position.X, 350, hrp.Position.Z)
                    platformPart.Anchored = true
                    platformPart.Transparency = 0.5
                    platformPart.BrickColor = BrickColor.new("Bright blue")
                    platformPart.Parent = Workspace
                end
                hrp.CFrame = CFrame.new(platformPart.Position + Vector3.new(0, 3, 0))
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            else
                if platformPart then
                    platformPart:Destroy()
                    platformPart = nil
                    totalWins = totalWins + 1
                    SendDiscordWebhook("🎉 ฟาร์มสำเร็จผ่านไปอีก 1 รอบแล้ว!")
                end
            end
        end)
    else
        if farmConnection then farmConnection:Disconnect() farmConnection = nil end
        if platformPart then platformPart:Destroy() platformPart = nil end
    end
end)

