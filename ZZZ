-- ระบบขยายหน้าต่างอิสระ (Resize Handle)
local ResizeBtn = Instance.new("TextButton")
ResizeBtn.Size = UDim2.new(0, 18, 0, 18)
ResizeBtn.Position = UDim2.new(1, -18, 1, -18)
ResizeBtn.BackgroundTransparency = 1
ResizeBtn.Text = "◢"
ResizeBtn.TextColor3 = Color3.fromRGB(150, 150, 180)
ResizeBtn.TextSize = 12
ResizeBtn.Parent = MainFrame

local resizing = false
local resizeStartPos, startSize

ResizeBtn.MouseButton1Down:Connect(function()
    resizing = true
    resizeStartPos = UserInputService:GetMouseLocation()
    startSize = MainFrame.AbsoluteSize
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then resizing = false end
end)

UserInputService.InputChanged:Connect(function(input)
    if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = UserInputService:GetMouseLocation() - resizeStartPos
        local newWidth = math.clamp(startSize.X + delta.X, 300, 700)
        local newHeight = math.clamp(startSize.Y + delta.Y, 250, 650)
        MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
        normalSize = UDim2.new(0, newWidth, 0, newHeight)
    end
end)
