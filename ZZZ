-- ฟังก์ชันส่งแจ้งเตือนเข้า Discord
local function SendDiscordWebhook(statusText)
    if savedWebhookUrl == "" or not savedWebhookUrl:find("https://discord.com/api/webhooks/") then return end
    
    local totalSeconds = math.floor(tick() - scriptStartTime)
    local hours = math.floor(totalSeconds / 3600)
    local minutes = math.floor((totalSeconds % 3600) / 60)
    local seconds = totalSeconds % 60
    local afkTimeStr = string.format("%d ชม. %d นาที %d วินาที", hours, minutes, seconds)
    
    local data = {
        ["content"] = "",
        ["embeds"] = {{
            ["title"] = "🤖 Evade Abdul Hub - สถานะการฟาร์ม",
            ["description"] = statusText,
            ["color"] = 3066993,
            ["fields"] = {
                {["name"] = "⏳ ระยะเวลา AFK", ["value"] = afkTimeStr, ["inline"] = true},
                {["name"] = "🏆 รอบที่ชนะ/ฟาร์ม", ["value"] = tostring(totalWins) .. " รอบ", ["inline"] = true},
                {["name"] = "👤 ผู้เล่น", ["value"] = LocalPlayer.Name, ["inline"] = false}
            },
            ["footer"] = {["text"] = "ระบบแจ้งเตือนอัตโนมัติจาก Roblox Evade"},
            ["timestamp"] = DateTime.now():ToIsoDate()
        }}
    }
    
    local body = HttpService:JSONEncode(data)
    local headers = {["Content-Type"] = "application/json"}
    
    pcall(function()
        HttpService:PostAsync(savedWebhookUrl, body, Enum.HttpContentType.ApplicationJson, false, headers)
    end)
end

